rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Esquema de un pendiente. `notified` solo lo cambia el Worker (cuenta de servicio, que ignora las reglas).
    function validTask(d) {
      return d.keys().hasOnly(['uid', 'title', 'date', 'time', 'remindMin', 'remindAt', 'notified', 'done', 'createdAt', 'nagMin', 'nagAt', 'nagCount'])
        && d.keys().hasAll(['uid', 'title', 'date', 'time', 'remindMin', 'remindAt', 'notified', 'done', 'createdAt'])
        && d.uid is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.remindMin in [-1, 0, 5, 15, 30, 60, 1440]
        && (d.remindAt == null || d.remindAt is int)
        && ((d.remindMin == -1) == (d.remindAt == null))
        && d.notified is bool
        && d.done is bool
        && d.createdAt is timestamp
        // Insistencia (opcional: los pendientes anteriores no tienen estos campos).
        && d.get('nagMin', 0) in [0, 5, 10, 15, 30]
        && (d.get('nagAt', null) == null || d.get('nagAt', null) is int)
        && d.get('nagCount', 0) is int && d.get('nagCount', 0) >= 0;
    }

    // Cada usuario solo ve y modifica sus propios pendientes.
    match /tasks/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && validTask(request.resource.data)
                    && request.resource.data.notified == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.get('nagAt', null) == null
                    && request.resource.data.get('nagCount', 0) == 0;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && validTask(request.resource.data)
                    // `notified` solo lo pone en true el Worker. El cliente puede volver a armarlo (false) únicamente
                    // al reprogramar el aviso (cambia remindAt); en cualquier otro caso debe dejarlo igual.
                    && (request.resource.data.notified == resource.data.notified
                        || (request.resource.data.notified == false
                            && request.resource.data.remindAt != resource.data.remindAt))
                    && request.resource.data.createdAt == resource.data.createdAt
                    // La cadena de insistencias la programa el Worker: el cliente solo puede cortarla (nagAt null, nagCount 0).
                    && (request.resource.data.get('nagAt', null) == null
                        || request.resource.data.get('nagAt', null) == resource.data.get('nagAt', null))
                    && (request.resource.data.get('nagCount', 0) == 0
                        || request.resource.data.get('nagCount', 0) == resource.data.get('nagCount', 0));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Preferencias por cuenta: formato de hora, máximo de insistencias y duración de "Posponer" (el Worker las lee con la cuenta de servicio).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['timeFormat', 'nagMax', 'snoozeMin'])
                            && request.resource.data.size() >= 1
                            && request.resource.data.get('timeFormat', '24') in ['12', '24']
                            && request.resource.data.get('nagMax', 5) in [3, 5, 10, 20]
                            && request.resource.data.get('snoozeMin', 10) in [5, 10, 15, 30, 60];
    }

    // Tokens de notificación: solo se escriben/borran los propios (el Worker los lee con cuenta de servicio).
    match /tokens/{token} {
      allow create, update: if signedIn()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['uid', 'ua', 'updatedAt'])
                            && request.resource.data.ua is string && request.resource.data.ua.size() <= 120
                            && request.resource.data.updatedAt == request.time;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
